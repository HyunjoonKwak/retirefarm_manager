// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 사용자 ====================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // SSO 사용자는 비밀번호 없음
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // SSO 관련 필드
  isSsoUser     Boolean   @default(false)
  portalEmail   String?   @unique  // My Portal 계정 연동용
  ssoEnabled    Boolean   @default(true)

  retirementGoal    RetirementGoal?
  realEstateAssets  RealEstateAsset[]
  setupCostItems    SetupCostItem[]
  fundingSources    FundingSource[]
  farmingLogs       FarmingLog[]
  crops             Crop[]
  transactions      FinancialTransaction[]
  inventory         InventoryItem[]
  priceWatchlist           PriceWatchlist[]
  priceAlerts              PriceAlert[]
  notifications            Notification[]
  productWatchlist         ProductWatchlist[]
  marketCollectionSettings MarketCollectionSettings?
}

// ==================== 스마트팜 준비 계획 ====================
model RetirementGoal {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  targetDate             DateTime // 퇴직 목표일
  estimatedRetirementPay Decimal? // DC 퇴직금 예상액
  estimatedSeverancePay  Decimal? // 퇴직수당 예상액
  initialLivingBuffer    Decimal? // 초기 생활비 버퍼
  bufferMonths           Int?     @default(6) // 버퍼 개월 수
  monthlyLivingExpense   Decimal? // 월 생활비 (버퍼 계산용)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== 부동산 자산 ====================
model RealEstateAsset {
  id                String      @id @default(cuid())
  userId            String
  name              String
  propertyType      String      // PropertyType enum -> String
  address           String
  area              Decimal
  acquisitionDate   DateTime
  acquisitionPrice  Decimal
  currentPrice      Decimal
  expectedSalePrice Decimal
  mortgageBalance   Decimal     @default(0)
  monthlyRent       Decimal?
  status            String      @default("HOLDING") // AssetStatus enum -> String
  plannedSaleDate   DateTime?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundingSource FundingSource?
}

// ==================== 설립 비용 ====================
model SetupCostCategory {
  id            String                @id @default(cuid())
  name          String
  order         Int                   @default(0)
  subcategories SetupCostSubcategory[]
}

model SetupCostSubcategory {
  id         String            @id @default(cuid())
  categoryId String
  name       String
  order      Int               @default(0)

  category SetupCostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    SetupCostItem[]
}

model SetupCostItem {
  id               String     @id @default(cuid())
  userId           String
  subcategoryId    String
  name             String
  description      String?
  estimatedCost    Decimal
  actualCost       Decimal?
  quantity         Int        @default(1)
  unit             String     @default("개")
  areaInPyeong     Decimal?   // 면적 (평)
  pricePerPyeong   Decimal?   // 평단가 (원)
  personCount      Int?       // 인원수 (인건비용)
  pricePerPerson   Decimal?   // 인당 단가 (인건비용)
  durationMonths   Int?       // 기간 (개월, 인건비용)
  isGovernmentSubsidy Boolean @default(false)
  subsidyAmount    Decimal?
  subsidyRate      Decimal?
  priority         String     @default("ESSENTIAL") // Priority enum -> String
  status           String     @default("PLANNED")   // ItemStatus enum -> String
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategory SetupCostSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
}

// ==================== 자금 조달 ====================
model FundingSource {
  id            String        @id @default(cuid())
  userId        String
  type          String        // FundingType enum -> String
  name          String
  amount        Decimal
  expectedDate  DateTime
  linkedAssetId String?       @unique
  status        String        @default("PLANNED") // FundingStatus enum -> String
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAsset RealEstateAsset? @relation(fields: [linkedAssetId], references: [id])
}

// ==================== 영농일지 ====================
model FarmingLog {
  id          String         @id @default(cuid())
  userId      String
  date        DateTime
  temperature Decimal?
  humidity    Int?
  rainfall    Decimal?
  weather     String?
  notes       String?
  photos      String?        // String[] -> String (JSON 형식으로 저장)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities FarmActivity[]

  @@unique([userId, date])
}

model FarmActivity {
  id          String       @id @default(cuid())
  logId       String
  type        String       // ActivityType enum -> String
  cropId      String?
  plotId      String?
  description String
  quantity    Decimal?
  unit        String?
  duration    Int?
  workers     Int?
  createdAt   DateTime     @default(now())

  log            FarmingLog           @relation(fields: [logId], references: [id], onDelete: Cascade)
  crop           Crop?                @relation(fields: [cropId], references: [id])
  materialUsages MaterialUsage[]
}

model MaterialUsage {
  id         String   @id @default(cuid())
  activityId String
  itemId     String
  quantity   Decimal

  activity FarmActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id])
}

// ==================== 작물 ====================
model Crop {
  id                  String      @id @default(cuid())
  userId              String
  name                String
  variety             String?
  plantingDate        DateTime
  expectedHarvestDate DateTime
  plotId              String?
  status              String      @default("GROWING")  // CropStatus enum -> String
  growthStage         String      @default("SEEDING")  // GrowthStage enum -> String
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities   FarmActivity[]
  transactions FinancialTransaction[]
}

// ==================== 재무 ====================
model FinancialTransaction {
  id            String          @id @default(cuid())
  userId        String
  date          DateTime
  type          String          // TransactionType enum -> String
  category      String
  subcategory   String?
  amount        Decimal
  description   String
  relatedCropId String?
  paymentMethod String?
  receiptUrl    String?
  createdAt     DateTime        @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  crop Crop? @relation(fields: [relatedCropId], references: [id])
}

// ==================== 재고 ====================
model InventoryItem {
  id               String            @id @default(cuid())
  userId           String
  name             String
  category         String            // InventoryCategory enum -> String
  currentQuantity  Decimal
  unit             String
  minimumQuantity  Decimal           @default(0)
  lastPurchaseDate DateTime?
  lastPurchasePrice Decimal?
  location         String?
  expirationDate   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   InventoryTransaction[]
  materialUsages MaterialUsage[]
}

model InventoryTransaction {
  id       String   @id @default(cuid())
  itemId   String
  type     String   // "IN" | "OUT"
  quantity Decimal
  date     DateTime
  reason   String

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ==================== 시세 정보 ====================

// 가락시장 경매결과
model AuctionResult {
  id            String   @id @default(cuid())
  productName   String   // PUMMOK 품목명
  variety       String?  // PUMJONG 품종명
  tempName      String?  // PUM_NAME_IMSI 임시품목명
  unit          String   // UUN 거래단량
  grade         String?  // DDD 등급
  price         Int      // PPRICE 경락가
  origin        String?  // SSANGI 산지명
  corporation   String   // CORP_NM 법인명
  corporationCode String // 법인코드
  auctionDate   DateTime // ADJ_DT 경매일자
  quantity      Int      @default(1) // QTY 수량
  certification String?  // INJUNG_GUBUN 인증구분
  createdAt     DateTime @default(now())

  @@unique([productName, variety, corporation, auctionDate, price, origin])
  @@index([productName, auctionDate])
  @@index([auctionDate])
  @@index([origin])
}

// 관심 품목 (가락시장용)
model ProductWatchlist {
  id          String   @id @default(cuid())
  userId      String
  productName String   // 품목명 (토마토, 딸기 등)
  variety     String   @default("") // 품종명 (대추빨강 등) - 빈 문자열이면 전체
  origin      String   @default("") // 산지명 - 빈 문자열이면 전체
  targetPrice Int?     // 목표가격 (알림용)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productName, variety, origin])
}

// 데이터 수집 로그
model DataCollectionLog {
  id           String   @id @default(cuid())
  targetDate   DateTime // 수집 대상 일자
  corporation  String   // 법인코드
  totalCount   Int      // 총 수집 건수
  newCount     Int      // 신규 저장 건수
  status       String   // SUCCESS, FAILED, PARTIAL
  errorMessage String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([targetDate])
  @@index([status])
}

// 시세 수집 설정
model MarketCollectionSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  // 자동 수집 설정
  autoCollectEnabled  Boolean  @default(false)
  collectTime         String   @default("06:00") // HH:mm 형식
  collectDaysAgo      Int      @default(1) // 몇 일 전 데이터 수집 (1=어제)
  // 수집 대상
  corporationCodes    String   @default("11000101") // 쉼표로 구분
  // 데이터 보관 설정
  retentionDays       Int      @default(90) // 보관 기간 (일)
  autoCleanupEnabled  Boolean  @default(true) // 자동 정리 활성화
  // 조회 설정
  defaultViewDays     Int      @default(30) // 기본 조회 기간
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PriceWatchlist {
  id       String @id @default(cuid())
  userId   String
  itemCode String
  itemName String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemCode])
}

model PriceAlert {
  id          String  @id @default(cuid())
  userId      String
  itemCode    String
  itemName    String
  condition   String  // "ABOVE" | "BELOW"
  targetPrice Decimal
  isActive    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketPriceCache {
  id            String   @id @default(cuid())
  itemCode      String
  itemName      String
  marketCode    String
  marketName    String
  date          DateTime
  avgPrice      Decimal
  maxPrice      Decimal
  minPrice      Decimal
  tradingVolume Decimal
  unit          String
  fetchedAt     DateTime @default(now())

  @@unique([itemCode, marketCode, date])
  @@index([itemCode, date])
}

// ==================== 알림 ====================
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      String           // NotificationType enum -> String
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
