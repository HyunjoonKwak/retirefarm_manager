# Database (SQLite)
DATABASE_URL="file:./prisma/data/retirefarm.db"

# 로컬 개발용 데이터 디렉토리
DATA_PATH="./data"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3024"

# Kakao OAuth
KAKAO_CLIENT_ID="your_kakao_client_id"
KAKAO_CLIENT_SECRET="your_kakao_client_secret"

# Garak Market API (가락시장 공공데이터)
GARAK_API_ID="your_garak_api_id"
GARAK_API_PASSWORD="your_garak_api_password"

# Cron endpoint protection (외부 크론 호출 보호용 시크릿)
CRON_SECRET="your_random_secret"

# External Portfolio API (nas_naver_crawler 연동)
EXTERNAL_PORTFOLIO_API_URL="https://your-portfolio-service"
EXTERNAL_PORTFOLIO_API_KEY="your_service_api_key"

# Backup
BACKUP_DIR="/backups"
BACKUP_PATH="./backups"

# GHCR (GitHub Container Registry — 배포용)
GHCR_TOKEN="ghp_your_github_personal_access_token"
GHCR_USERNAME="your_github_username"

# Logging (선택: 프로덕션에서 info 로그 출력)
# LOG_VERBOSE="true"
