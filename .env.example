# Database (SQLite)
DATABASE_URL="file:./prisma/data/retirefarm.db"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3024"

# KAMIS API (농수산물유통정보)
KAMIS_API_KEY="your_kamis_api_key"
KAMIS_API_ID="your_kamis_api_id"

# Weather API (optional - 기상청)
WEATHER_API_KEY="your_weather_api_key"

# My Portal SSO
MY_PORTAL_API_URL="http://localhost:3022/api"
NEXT_PUBLIC_MY_PORTAL_URL="http://localhost:3022"

# Backup
BACKUP_DIR="/backups"
BACKUP_PATH="./backups"

# GHCR (GitHub Container Registry)
GHCR_TOKEN="ghp_your_github_personal_access_token"
GHCR_USERNAME="your_github_username"
